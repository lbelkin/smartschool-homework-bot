# Copy this file outside the repository, fill the values and chmod 600 it.
WEBTOP_WEB_TOKEN='replace-with-webtop-session-token'
WEBTOP_STUDENT='replace-with-student-name'
TELEGRAM_BOT_TOKEN='replace-with-telegram-bot-token'
TELEGRAM_CHAT_ID='replace-with-private-chat-id'
SCHEDULE_URI='/absolute/private/path/to/schedule.ics'
SCHEDULE_SOURCE='auto'
# Optional override when the dashboard does not expose the academic-year start.
# WEBTOP_STUDY_YEAR='2026'
# Optional bell times when Webtop returns lesson numbers without clock times.
# WEBTOP_PERIOD_TIMES='{"1":"08:00-08:45","2":"08:50-09:35"}'
LOOKBACK_WEEKS=4
